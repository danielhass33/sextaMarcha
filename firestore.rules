rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function active() { return signedIn() && exists(/databases/$(database)/documents/partners/$(request.auth.uid)) && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'active'; }
  function admin() { return active() && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.role == 'admin'; }
  match /partners/{id} { allow read: if admin() || (signedIn() && request.auth.uid == id); allow write: if false; }
  match /sales/{id} { allow read: if admin() || (active() && resource.data.partnerId == request.auth.uid); allow write: if false; }
  match /courses/{id} { allow read: if true; allow write: if false; }
  match /students/{id} { allow read, write: if false; }
  match /commissions/{id} { allow read, write: if false; }
  match /payouts/{id} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
